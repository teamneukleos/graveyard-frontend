# Next.js app (port 3001 — Nest API stays on 3000)
APP_URL=http://localhost:3001

# NestJS API base URL (server)
GRAVEYARD_API_URL=http://localhost:3000
# Same URL exposed to the browser (Google OAuth start button)
NEXT_PUBLIC_GRAVEYARD_API_URL=http://localhost:3000

# Must match graveyard-api JWT_SECRET
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Email is sent by graveyard-api (Resend). Configure RESEND_* there.

# Google OAuth is handled by graveyard-api. Configure GOOGLE_* there.
# Nest FRONTEND_URL must be http://localhost:3001 so the API redirects
# back to this app's /api/auth/google/callback after Google sign-in.
# Authorized redirect URI: {GRAVEYARD_API_URL}/auth/google/callback
